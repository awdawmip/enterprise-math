+def blob_sha_file(path):
+    """Hash one stable regular file without allocating its complete contents.
+
+    Keep the descriptor bound to the opened inode, reject symlinks, and fail
+    closed if the inode, path identity, size or timestamps change during hashing.
+    Private request materialization remains a copy, never a cache hardlink.
+    """
+    path=Path(path)
+    try:
+        before=path.lstat()
+        if not stat.S_ISREG(before.st_mode):raise ControlError('BLOB_FILE_NOT_REGULAR')
+        fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_CLOEXEC|os.O_NONBLOCK)
+    except OSError as exc:
+        raise ControlError('BLOB_FILE_NOT_REGULAR') from exc
+    def identity(value):
+        return (value.st_dev,value.st_ino,value.st_mode,value.st_size,
+                value.st_mtime_ns,value.st_ctime_ns)
+    try:
+        opened=os.fstat(fd)
+        if not stat.S_ISREG(opened.st_mode) or identity(opened)!=identity(before):
+            raise ControlError('BLOB_FILE_CHANGED')
+        digest=hashlib.sha1();digest.update(b'blob '+str(opened.st_size).encode()+b'\0')
+        count=0
+        while chunk:=os.read(fd,1024*1024):
+            count+=len(chunk)
+            if count>opened.st_size:raise ControlError('BLOB_FILE_CHANGED')
+            digest.update(chunk)
+        try:after=path.lstat()
+        except OSError as exc:raise ControlError('BLOB_FILE_CHANGED') from exc
+        if (count!=opened.st_size or identity(os.fstat(fd))!=identity(opened)
+                or identity(after)!=identity(opened)):
+            raise ControlError('BLOB_FILE_CHANGED')
+        return digest.hexdigest()
+    finally:
+        os.close(fd)
+
