#!/usr/bin/env python3
"""Exact reference/precision audit of the previously declared quantum comparator.

NOT a derivation of quantum mechanics, native force dynamics, or Navier--Stokes.
Tensor products, Born readout, local number-conserving measurement instruments,
and degenerate pointer registers are declared mathematical comparison inputs.
The parent basis/partial-trace/register-permutation functions are imported
unchanged and actually executed. No floating-point arithmetic is used.
"""
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import sys
from itertools import product
from pathlib import Path

import sympy as sp

HERE = Path(__file__).resolve().parent
PARENT = HERE.parent / 'ns_dense_residual_d5c00d' / 'check_dense_residual.py'
EXPECTED = 'd7784336c350e5d3795c3c3163f55a1477752a264b842edc49af14cbdf0bddd1'
EVENT = 'NS-DENSE-REFERENCE-CLOSURE-20260916-D5C00D-17'


def load_parent():
    if hashlib.sha256(PARENT.read_bytes()).hexdigest() != EXPECTED:
        raise ValueError('Parent source mismatch; re-audit before changing the pin.')
    spec = importlib.util.spec_from_file_location('verified_dense16', PARENT)
    if spec is None or spec.loader is None:
        raise RuntimeError('Cannot import the verified parent.')
    mod = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = mod
    spec.loader.exec_module(mod)
    return mod


def expect_zero(mat):
    if sp.simplify(mat) != sp.zeros(*mat.shape):
        raise AssertionError(f'Nonzero exact matrix: {mat}')


def embed_three_reflection(n, ids):
    """Single-excitation block; identities on unused single-excitation ports."""
    if len(ids) != 3 or len(set(ids)) != 3 or not set(ids) <= set(range(n)):
        raise ValueError('Need three distinct, in-range ports.')
    G = sp.ones(3) * sp.Rational(2, 3) - sp.eye(3)
    mat = sp.eye(n)
    for a, i in enumerate(ids):
        for b, j in enumerate(ids):
            mat[i, j] = G[a, b]
    return mat


def state16(old):
    G = sp.ones(3) * sp.Rational(2, 3) - sp.eye(3)
    U = sp.eye(8)
    ids = (4, 2, 1)
    for a, i in enumerate(ids):
        for b, j in enumerate(ids):
            U[i, j] = G[a, b]
    psi = U * old.basis(8, 4)
    rho = old.ptrace(psi * psi.H, 3, (1, 2))
    assert rho == sp.Matrix([[1, 0, 0, 0], [0, 4, 4, 0],
                            [0, 4, 4, 0], [0, 0, 0, 0]]) / 9
    return U, psi, rho


def number_projectors():
    return (sp.diag(1, 0, 0, 0), sp.diag(0, 1, 1, 0), sp.diag(0, 0, 0, 1))


def reorder_copies(old, rho1, rho2):
    # (B1,C1,B2,C2) -> (B1,B2,C1,C2)
    perm = old.perm_matrix(4, (0, 2, 1, 3))
    return perm * sp.kronecker_product(rho1, rho2) * perm.H


def sector_dephase(omega):
    out = sp.zeros(16)
    for a, b in product(number_projectors(), repeat=2):
        p = sp.kronecker_product(a, b)
        out += p * omega * p
    return sp.simplify(out)


def logical_ops(kappa):
    # 0_L=01 and 1_L=10, both have local total excitation number one.
    z = sp.diag(0, 1, -1, 0)
    x = sp.zeros(4)
    x[1, 2] = x[2, 1] = 1
    outside = sp.diag(1, 0, 0, 1)
    a = (4 - kappa**2) / (4 + kappa**2)
    b = 4 * kappa / (4 + kappa**2)
    left = (z + outside, x + outside)
    right = (-a * z + b * x + outside, -a * z - b * x + outside)
    return left, right, a, b


def measure_statistics(rho, left, right):
    out = []
    correlations = []
    for i, A in enumerate(left):
        row = []
        for j, B in enumerate(right):
            val = sp.simplify(sp.trace(rho * sp.kronecker_product(A, B)))
            row.append(val)
            probs = {}
            for s, t in product((-1, 1), repeat=2):
                PA = (sp.eye(4) + s * A) / 2
                PB = (sp.eye(4) + t * B) / 2
                p = sp.simplify(sp.trace(rho * sp.kronecker_product(PA, PB)))
                assert p.is_Rational and p >= 0
                probs[(s, t)] = p
            assert sum(probs.values()) == 1
            for s in (-1, 1):
                assert sum(probs[(s, t)] for t in (-1, 1)) == sp.Rational(1, 2)
                assert sum(probs[(t, s)] for t in (-1, 1)) == sp.Rational(1, 2)
            out.append({'settings': [i, j],
                        'probabilities': {f'{s},{t}': str(p) for (s, t), p in probs.items()}})
        correlations.append(row)
    bell = sp.simplify(correlations[0][0] + correlations[0][1] +
                       correlations[1][0] - correlations[1][1])
    return bell, correlations, out


def number_measurement_unitary():
    """QND number flag: a three-valued, charge-degenerate pointer, initially 0."""
    shift = sp.Matrix([[0, 0, 1], [1, 0, 0], [0, 1, 0]])
    return sum((sp.kronecker_product(p, shift**n)
                for n, p in enumerate(number_projectors())), sp.zeros(12))


def binary_instrument(M):
    """Premeasurement: record ± outcome without resetting or tracing the pointer."""
    x = sp.Matrix([[0, 1], [1, 0]])
    return (sp.kronecker_product((sp.eye(4) + M) / 2, sp.eye(2)) +
            sp.kronecker_product((sp.eye(4) - M) / 2, x))


def local_channel(omega, M, side):
    """Nonselective outcome readout, retained as a channel only for this test."""
    out = sp.zeros(16)
    for s in (-1, 1):
        p = (sp.eye(4) + s * M) / 2
        op = sp.kronecker_product(p, sp.eye(4)) if side == 0 else sp.kronecker_product(sp.eye(4), p)
        out += op * omega * op
    return sp.simplify(out)


def run(denominator_steps=128):
    old = load_parent()
    # Exact denominator-growth proof certificate, checked for finite n below.
    A = embed_three_reflection(4, (0, 1, 2))
    B = embed_three_reflection(4, (1, 2, 3))
    T = B * A
    M = 9 * T
    assert all(v.is_Integer for v in M)
