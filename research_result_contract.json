  "persistence_boundary": {
    "execution_and_result": "Create execution provenance and result record in the same bounded publication batch as the durable return/checkpoint whenever possible.",
    "driver_review": "Canonical review command preflights one follow-up spec, creates the immutable review, automatically publishes the next taskbook/taskset or verifies canonical parent closure, and freezes the follow-up packet in the same review command.",
