  "reproduce_python": "# Standalone reproduction (Python 3; equivalent to executed JS batch algorithm, not executed here).\n# Supply JSON bytes from each pinned source to load(path, commit).\n# Every counted pair is a canonical nondecreasing integer partition pair.\nimport json, hashlib, math\ndef parts(n,l=1):\n    if n==0: yield ()\n    else:\n        for k in range(l,n+1):\n            for t in parts(n-k,k): yield (k,)+t\ndef key(p,n): return json.dumps([sorted(p),sorted(n)],separators=(',',':'))\ndef count(p): return math.prod(math.comb(11+p.count(a),p.count(a)) for a in set(p))\ndef audit_union(cert,load):\n    def rd(s):\n        b=load(s['path'],s['commit'])\n        assert hashlib.sha256(b).hexdigest()==s['sha256']\n        j=json.loads(b); assert j['frozen_science']==cert['frozen_science']; return j\n    a=[rd(s) for s in cert['audit_sources']]\n    pairs={}\n    def add(p,n,c,ws):\n        k=key(p,n)\n        assert k not in pairs and c['raw']==count(p)*count(n)\n        d=c.get('domain', c['raw']-c.get('over',0))\n        r=c.get('reps',c.get('actual',c.get('search')))\n        assert 0<=r<=d<=c['raw']\n        assert c.get('valid',0)==0 and len(ws)==c['leaves']\n        assert all(max(w['masses'])>2331 for w in ws)\n        pairs[k]=(1,c['raw'],d,r,c['nodes'],c['leaves'])\n    for s in cert['early_originals']:\n        for z in rd(s)['rows']:\n            ws=[w for w in a[0]['result']['witnesses'] if w['source']==s['path'] and sorted(w['neg_pattern'])==sorted(z['neg_pattern'])]\n            add(z['pos_pattern'],z['neg_pattern'],z,ws)\n    for j in a[1:]:\n        assert len(j['result']['rows'])==j['result']['covered_pairs']\n        for z in j['result']['rows']: add(z['pp'],z['np'],z.get('counts',z),z.get('witnesses',[]))\n    allkeys=set()\n    for i,row in enumerate(cert['rows']):\n        keys=sorted(key(p,n) for p in parts(i) for n in parts(13-i))\n        assert len(keys)==row[0] and not (allkeys & set(keys))\n        assert hashlib.sha256(('\\n'.join(keys)).encode()).hexdigest()==row[6]\n        assert [sum(pairs[k][j] for k in keys) for j in range(6)]==row[:6]\n        allkeys.update(keys)\n    assert set(pairs)==allkeys and len(allkeys)==885\n    dp=[1]+[0]*13\n    for q in range(1,14):\n        for _ in range(12):\n            for i in range(q,14): dp[i]+=dp[i-q]\n    assert all(row[1]==dp[i]*dp[13-i] for i,row in enumerate(cert['rows']))\n    return {k:sum(row[i] for row in cert['rows']) for i,k in enumerate(cert['columns'][:6])}\n",
