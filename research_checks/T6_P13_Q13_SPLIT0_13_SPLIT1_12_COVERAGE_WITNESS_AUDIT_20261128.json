  "verifier_javascript": "function audit(data){\n const assert=(b,m)=>{if(!b)throw Error(m)};\n const cap=2331,p=13,B=13**6,science=\"d84bd940cfb093cdc60e569f15cad58772a51dca\";\n const parts=(n,l=1)=>n===0?[[]]:Array.from({length:Math.max(0,n-l+1)},(_,i)=>i+l).flatMap(k=>parts(n-k,k).map(t=>[k,...t]));\n const choose=(n,k)=>{let v=1;for(let i=1;i<=k;i++)v=v*(n-i+1)/i;return Math.round(v)};\n const groups=pat=>[...new Set(pat)].map(q=>[q,pat.filter(x=>x===q).length]);\n // Independent label-multiplicity generating polynomial; count and sum of distinct degree-one labels.\n function count(pat,n){\n   const lim=Math.floor((cap-169*n+pat.length)/13);\n   let raw=1,global=new Map([[0,[1,0]]]),without=1;\n   for(const [q,m] of groups(pat)){\n     raw*=choose(11+m,m); without*=choose((q===1?10:11)+m,m);\n     let g=new Map([[\"0,0\",[1,0]]]);\n     for(let label=1;label<=12;label++){\n       const h=new Map();\n       for(const [key,[a,b]] of g){let [k,s]=key.split(\",\").map(Number);\n         for(let j=0;j<=m-k && s+j*label<=lim;j++){\n           const z=(k+j)+\",\"+(s+j*label),v=h.get(z)||[0,0];\n           h.set(z,[v[0]+a,v[1]+b+(q===1&&j>0?a:0)]);\n         }\n       }g=h;\n     }\n     const h=new Map();\n     for(const [s,[a,b]] of global)for(const [key,[c,d]] of g){\n       const [k,t]=key.split(\",\").map(Number);if(k!==m||s+t>lim)continue;\n       const v=h.get(s+t)||[0,0];h.set(s+t,[v[0]+a*c,v[1]+b*c+a*d]);\n     }global=h;\n   }\n   let feasible=0,distinct=0;for(const [a,b] of global.values()){feasible+=a;distinct+=b}\n   return {raw,feasible,distinct,commonRaw:12*(raw-without),limit:lim};\n }\n const mod=(x,m)=>((x%m)+m)%m;\n function inv(a,m){let [r,s]=[m,mod(a,m)],[x,y]=[0n,1n];while(s){let q=r/s;[r,s]=[s,r-q*s];[x,y]=[y,x-q*y]}assert(r===1n,\"inverse\");return mod(x,m)}\n const pow=(a,k)=>a**BigInt(k);\n const H=Array.from({length:6},(_,i)=>Array.from({length:12},(_,j)=>inv(pow(BigInt(j+1),i+1),pow(13n,i+1))));\n const U=data.map(d=>JSON.parse(d.remote.content)).find(c=>c.U).U.map(r=>r.map(BigInt));\n function det(a){let m=a.map(r=>r.slice()),d=1n,sgn=1n;for(let k=0;k<m.length-1;k++){if(!m[k][k]){let j=m.findIndex((r,i)=>i>k&&r[k]);if(j<0)return 0n;[m[k],m[j]]=[m[j],m[k]];sgn=-sgn}let piv=m[k][k];for(let i=k+1;i<m.length;i++)for(let j=k+1;j<m.length;j++){let v=m[i][j]*piv-m[i][k]*m[k][j];assert(v%d===0n,\"Bareiss exact division\");m[i][j]=v/d}for(let i=k+1;i<m.length;i++)m[i][k]=0n;d=piv}return sgn*m.at(-1).at(-1)}\n const W=Array.from({length:12},(_,i)=>BigInt(13*(i+1)-1));\n const abs=x=>x<0n?-x:x;\n const dot=(a,b)=>a.reduce((s,x,i)=>s+x*b[i],0n);\n assert(abs(det(U))===13n**21n,\"U determinant\");\n for(const u of U)for(let k=1;k<=6;k++)assert(mod(dot(u,H[k-1]),13n**BigInt(k))===0n,\"U kernel\");\n // The reduction of the six characters has rank six over F13; then the mixed map is surjective by successive base-13 lifting.\n const h=H.map(r=>r.map(x=>mod(x,13n)));let rank=0;\n for(let j=0;j<12&&rank<6;j++){let t=h.findIndex((r,i)=>i>=rank&&r[j]!==0n);if(t<0)continue;[h[t],h[rank]]=[h[rank],h[t]];let a=inv(h[rank][j],13n);h[rank]=h[rank].map(x=>mod(x*a,13n));for(let i=0;i<6;i++)if(i!==rank){let q=h[i][j];h[i]=h[i].map((x,l)=>mod(x-q*h[rank][l],13n))}rank++}\n assert(rank===6,\"mod13 rank\");\n const V=U.map(r=>r.map((x,i)=>x*W[i]));const G=V.map(r=>V.map(s=>dot(r,s)));\n let prev=1n,minN=0n,minD=1n,ratios=[];\n for(let k=1;k<=12;k++){let d=det(G.slice(0,k).map(r=>r.slice(0,k)));assert(d>0n,\"Gram positive\");assert(d>2n*BigInt(cap)**2n*prev,\"GS nearest two bound\");ratios.push([String(d),String(prev)]);if(k===1||d*minD<minN*prev){minN=d;minD=prev}prev=d}\n const summaries=[],seen=new Map(),witnesses=[];\n const keys=[\"raw\",\"over\",\"search\",\"nodes\",\"leaves\",\"valid\",\"common_included\",\"common_feasible\"];\n let bySplit={0:Object.fromEntries(keys.map(k=>[k,0])),1:Object.fromEntries(keys.map(k=>[k,0]))};\n for(const item of data){\n   const c=JSON.parse(item.remote.content),s=c.split[0],n=c.split[1],factor=s===0?1:12;\n   assert([0,1].includes(s)&&s+n===13&&c.p===13&&c.valuation===1&&c.total_q===13&&c.budget===cap&&c.frozen_science===science&&c.coset_denominator===B&&c.lattice_index===\"13^21\",\"scope \"+item.source.path);\n   const [a,b]=c.gs_min_sq.split(\"/\").map(BigInt);assert(a*minD===b*minN,\"GS certificate mismatch\");\n   if(c.U)assert(JSON.stringify(c.U)===JSON.stringify(U.map(r=>r.map(Number))),\"U mismatch\");\n   const sums=Object.fromEntries(keys.map(k=>[k,0]));\n   for(const r of c.rows){\n     const pat=r.neg_pattern,pk=pat.join(\",\"),id=s+\":\"+pk;\n     assert(JSON.stringify(r.pos_pattern)===JSON.stringify(s===0?[]:[1]),\"positive partition \"+id);\n     assert(pat.reduce((a,b)=>a+b,0)===n&&pat.every((x,i)=>Number.isInteger(x)&&x>0&&(!i||x>=pat[i-1])),\"partition \"+id);\n     assert(!seen.has(id),\"duplicate \"+id);seen.set(id,item.source.path);\n     if(c.negative_length)assert(pat.length===c.negative_length,\"length \"+id);\n     if(c.negative_lengths)assert(c.negative_lengths.includes(pat.length),\"lengths \"+id);\n     const ct=count(pat,n);\n     assert(r.raw===factor*ct.raw&&r.search===factor*ct.feasible&&r.over===r.raw-r.search,\"roster count \"+id);\n     if(s===1)assert(r.common_included===ct.commonRaw&&r.common_feasible===ct.distinct,\"common atom counts \"+id);\n     assert(r.leaves===r.witnesses.length&&r.valid===0,\"leaf count \"+id);\n     for(const w of r.witnesses){\n       const P=w.pos,N=w.neg,u=w.u.map(BigInt),z=w.z.map(BigInt);\n       assert(JSON.stringify(P.map(a=>a[0]))===JSON.stringify(r.pos_pattern)&&JSON.stringify(N.map(a=>a[0]))===JSON.stringify(pat),\"witness pattern \"+id);\n       assert([...P,...N].every(a=>Number.isInteger(a[1])&&a[1]>=1&&a[1]<=12),\"label \"+id);\n       assert(u.length===12&&z.length===12,\"coordinate length \"+id);\n       for(let j=0;j<12;j++)assert(z.reduce((a,x,i)=>a+x*U[i][j],0n)===BigInt(B)*u[j],\"lattice coordinates \"+id);\n       const atomMass=A=>A.reduce((a,[q,r])=>a+BigInt(169*q+13*r-1),0n);\n       const cp=atomMass(P),cn=atomMass(N);\n       assert(cp<=BigInt(cap)&&cn<=BigInt(cap),\"atom mass \"+id);\n       let mp=cp,mn=cn,norm=0n;for(let j=0;j<12;j++){let x=u[j]*W[j];norm+=x*x;if(x>0n)mp+=x;else mn-=x}\n       let radius=(BigInt(cap)-cp)**2n+(BigInt(cap)-cn)**2n;\n       for(let k=1;k<=6;k++){let m=13n**BigInt(k),v=dot(u,H[k-1]);for(const [q,r] of N)v-=inv(pow(BigInt(13*q+r),k),m);for(const [q,r] of P)v+=inv(pow(BigInt(13*q+r),k),m);assert(mod(v,m)===0n&&w.residues[k-1]===0,\"congruences \"+id)}\n       assert(norm===BigInt(w.norm_sq)&&radius===BigInt(w.radius_sq)&&norm<=radius,\"ball \"+id);\n       assert(mp===BigInt(w.masses[0])&&mn===BigInt(w.masses[1])&&w.budget_valid===false&&(mp>BigInt(cap)||mn>BigInt(cap)),\"budget \"+id);\n       witnesses.push({split:s,neg_pattern:pat,pos:P,neg:N,u:w.u,masses:w.masses,norm_sq:w.norm_sq,radius_sq:w.radius_sq,source:item.source.path});\n     }\n     for(const k of keys){const v=r[k]??0;assert(Number.isSafeInteger(v)&&v>=0,\"count \"+k);sums[k]+=v}\n   }\n   for(const k of keys)if(k in c.totals)assert(c.totals[k]===sums[k],\"total \"+k+\" \"+item.source.path);\n   for(const k of keys)bySplit[s][k]+=sums[k];\n   summaries.push({commit:item.source.commit,path:item.source.path,blob:item.remote.sha,recorded_sha256:item.source.sha256,rows:c.rows.length,totals:sums});\n }\n for(let s=0;s<=1;s++){const expected=parts(13-s);assert(expected.every(pat=>seen.has(s+\":\"+pat.join(\",\"))),\"missing partition \"+s);assert([...seen.keys()].filter(x=>x.startsWith(s+\":\")).length===expected.length,\"unexpected partition \"+s);bySplit[s].pairs=expected.length}\n return {summaries,bySplit,covered_pairs:seen.size,witnesses,geometry:{kernel_determinant:\"13^21\",rank_mod13:rank,gram_schmidt_squared_unreduced:ratios,minimum_matches_prior:true,all_gs_squared_gt_2cap_squared:true}};\n}",
