    "coverage_router": "tools/enterprise_toolbox.py",
    "coverage_lookup_is_tool_use": false,
    "relevant_match_requires_reuse_resolution": true,
    "execution_unavailability_is_capability_gap": false
  },
  "role_transitions": {
    "matrix": "control_plane/role_transition_matrix.json",
    "mode": "TYPED_SELECTIVE_MERGE",
    "role_switch_is_context_reset": false,
    "identity_provenance_may_persist": true,
    "source_role_authority_persists_implicitly": false,
    "role_switch_releases_or_duplicates_claim": false,
    "free_clean_blindness_recoverable_after_agenda_exposure": false,
    "working_truth_follows_role_label": false,
    "tool_visibility_recomputed_from_destination_mode": true,
    "owner_scope_liveness_recomputed_from_destination_task_claim": true,
    "destination_role_messages_refresh_suspended_task_liveness": false,
    "invariant": "PRESERVE_PROVENANCE_AND_DURABLE_FRONTIER_WHILE_RECOMPUTING_DESTINATION_AUTHORITY"
  },
  "control_liveness": {
    "contract": "active_turn_liveness.json",
    "mode": "CONTROL_PLANE_MAINTENANCE",
    "watchdog": "COOPERATIVE_SOFT_WATCHDOG",
    "user_interrupt_preempts_nonessential_diagnostics": true,
    "long_research_compute_is_not_control_plane_no_progress": true
  },
  "precedence": {
    "rule": "For fields inside this file's scope only, this control precedence plus the named exact machine contract controls over stale V1 compatibility wording in older architecture, role, runtime, or human documents. Those older documents retain authority for their non-control mathematical/role semantics.",
    "does_not_override": [
      "MATHEMATICAL_TRUTH",
      "THEOREM_STATUS",
      "WORKING_TRUTH_AUTHORITY",
      "DRIVER_PORTFOLIO_AUTHORITY",
      "FOUNDATION_STEWARD_AUTHORITY",
      "RESEARCH_DISCOVERY_FIREWALL",
      "TASK_LOCAL_MATHEMATICAL_SCOPE"
    ],
    "stale_v1_pointer_semantics": "COMPATIBILITY_METADATA_ONLY_UNLESS_EXPLICITLY_LABELED_LEGACY_EXISTING_EXECUTION",
    "fresh_selector_named_canonical_in_older_doc": "INTERPRET_AS_SUBORDINATE_SELECTOR_NOT_TOP_LEVEL_LIVE_ENTRYPOINT",
    "role_transition_rule": "ROLE-SPECIFIC AUTHORITY IS CLEARED/REACTIVATED BY DESTINATION CONTRACT; CONTEXT AND PROVENANCE ARE NOT PRETENDED TO RESET"
  },
  "role_expectations": {
    "TASK_RESEARCH": [
      "GLOBAL_KNOWLEDGE_TASK_BOOTSTRAP_WHEN_AVAILABLE",
      "EXACT_TASK_FIRST",
      "TOOL_COVERAGE_BEFORE_NEW_GENERAL_MECHANISM",
      "REUSE_RESOLUTION_AFTER_RELEVANT_MATCH",
      "IMMUTABLE_V2_TASK_PUBLICATION"
    ],
    "FREE_AXIOM_DISCOVERY_PHASE_A": [
      "GLOBAL_KNOWLEDGE_FREE_BOOTSTRAP_WHEN_AVAILABLE",
