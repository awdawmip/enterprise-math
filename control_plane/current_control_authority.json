{
  "schema": "ENTERPRISE_MATH_CURRENT_CONTROL_AUTHORITY_V1",
  "status": "ACTIVE_CANONICAL_CONTROL_PRECEDENCE",
  "effective": "2026-08-28",
  "classification": "NO_NEW_MATHEMATICS_CONTROL_PLANE_ONLY",
  "purpose": "Provide one narrow precedence layer for task publication, live dispatch, runtime fault isolation, exact owner-scope liveness, tool reuse resolution, typed role transitions, and chat-only control liveness without replacing mathematical, theorem, Driver, Steward, or research-role semantics carried by their owning contracts.",
  "scope": [
    "TASK_PUBLICATION_AUTHORITY",
    "LIVE_DISPATCH_ENTRYPOINT",
    "OWNER_SCOPE_SESSION_LIVENESS",
