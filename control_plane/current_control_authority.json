    "RESEARCH_DRIVER": [
      "DRIVER_CONTINUITY_IS_ROUTING_ONLY",
      "IMMUTABLE_V2_TASK_AUTHORITY",
      "RESEARCH_CONTROL_DISPATCH_IS_LIVE_ENTRYPOINT",
      "TOOL_REUSE_RESOLUTION_BEFORE_NEW_TOOL_DIRECTION"
    ],
    "FOUNDATION_STEWARD": [
      "STEWARD_AUTHORITY_SEPARATE_FROM_IDENTITY",
      "IMMUTABLE_V2_GOVERNANCE_TASK_PUBLICATION",
      "RESEARCH_CONTROL_DISPATCH_FOR_EXECUTION_HANDOFFS",
      "TOOL_REUSE_RESOLUTION_BEFORE_ACCEPTING_SHARED_MACHINERY"
    ],
    "CONTROL_PLANE_MAINTENANCE": [
      "NO_RESEARCH_ROLE_IDENTITY",
      "NO_THEOREM_OR_REVIEW_AUTHORITY",
      "BOUNDED_DIAGNOSTIC_EXPANSION",
      "WRITE_AUTHORITY_REFRESH_BEFORE_MUTATION"
    ]
  }
}
