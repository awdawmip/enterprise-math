  "publish_contract": {
    "allowed_publisher_roles": [
      "RESEARCHER",
      "RESEARCH_DRIVER",
      "STEWARD",
      "USER"
    ],
    "publication_state": "PUBLISHED",
    "publication_is_dispatch_approval": false,
    "free_researcher_may_publish": true,
    "free_researcher_is_auto_dispatch_eligible": false,
    "publisher_id_required_for_roles": [
      "RESEARCHER",
      "RESEARCH_DRIVER",
      "STEWARD"
    ],
    "required_task_fields": [
      "title",
      "kind",
      "owner",
      "priority",
      "leverage",
      "frontier",
      "next_action"
    ],
    "rule": "PUBLISH creates a first-class scheduler task immediately but never makes it dispatchable. Independent Driver dispatch review is required before READY."
  },
  "review_contract": {
    "event": "REVIEW",
    "reviewer_role": "RESEARCH_DRIVER",
    "reviewer_id_required": true,
    "required_fields": [
      "review_stage",
      "verdict",
      "reviewer_id",
      "review_ref"
    ],
    "review_stages": [
      "DISPATCH",
      "RETURN",
      "RECOVERY"
    ],
    "verdicts": [
      "ACCEPT",
      "CHANGES_REQUESTED",
      "REJECT"
    ],
    "dispatch": {
      "from_states": ["PUBLISHED"],
      "accept_to": "READY",
      "changes_requested_to": "PUBLISHED",
      "reject_to": "REJECTED",
      "taskbook_policy_pass_required_when_taskbook_ref_present": true,
      "cross_review_rule": "reviewer_id must differ from publisher_id when publisher_id is present"
    },
    "return": {
      "from_states": ["RETURNED"],
      "accept_to": "DONE",
      "changes_requested_to": "CHANGES_REQUESTED",
      "reject_allowed": false,
      "cross_review_rule": "reviewer_id must differ from the last executor identity"
    },
    "recovery": {
      "from_states": ["ORPHANED"],
      "accept_to": "HANDOFF_READY",
      "changes_requested_to": "ORPHANED",
      "reject_to": "REJECTED",
      "next_action_required_on_accept": true
    },
    "rule": "No V2 worker event can transition a research task directly to DONE. RETURNED becomes DONE only through an accepted Driver RETURN review."
  },
  "selection_policy": {
    "default_kind": "RESEARCH",
    "eligible_task_states": [
      "HANDOFF_READY",
      "CHANGES_REQUESTED",
      "READY"
    ],
    "state_order": [
      "HANDOFF_READY",
      "CHANGES_REQUESTED",
      "READY"
    ],
    "priority_order": ["P0", "P1", "P2", "P3"],
    "leverage_order": ["HIGH", "MEDIUM", "LOW"],
    "staleness_order": "oldest_last_progress_first",
    "tie_break": "task_id",
    "skip_live_leases": true,
    "skip_complete_hard_dependencies": false,
    "research_only_by_default": true,
    "orphan_requires_recovery_review_before_dispatch": true,
    "live_cli_selection_requires_runtime_event_export": true
  },
  "handoff_contract": {
    "unfinished_session_requires_handoff": true,
    "required_fields": [
      "task_id",
      "actor",
      "at",
      "claim_id",
      "progress_ref",
      "next_action"
    ],
    "v2_silent_abandonment_recovery": "V2 claim lease expiry produces ORPHANED plus a durable derived orphan_history record",
    "legacy_v1_replay": "Historical V1 claim expiry preserves a durable orphan_history record but retains the old HANDOFF_READY/reclaim behavior so append-only V1 history is not rewritten.",
    "ack_required": false
  },
  "orphan_contract": {
    "state": "ORPHANED",
    "auto_on_v2_lease_expiry": true,
    "auto_register_untracked_taskbooks_as_orphaned": true,
    "preserve_history_after_recovery": true,
    "explicit_event": "ORPHAN",
    "explicit_required_fields": [
      "orphan_reason",
      "discovered_by",
      "source_ref"
    ],
    "derived_record_fields": [
      "orphaned_at",
      "reason",
      "claim_id",
      "actor",
      "researcher_id",
      "last_progress_ref",
      "next_action"
    ],
    "recovery_requires_driver": true,
    "recovery_event": "RECOVER",
    "rule": "A V2 orphan is never silently converted to HANDOFF_READY. It remains visibly ORPHANED until a Driver records recovery/adoption or rejection. Historical V1 expiry may replay its old handoff semantics only while retaining an orphan_history record."
  },
  "hard_block_contract": {
    "required_fields": [
      "missing_object",
      "owner",
      "necessity",
      "unblock_condition"
    ],
    "only_hard_dependency_can_block": true,
    "ci_review_moving_main_are_not_hard_blocks": true
