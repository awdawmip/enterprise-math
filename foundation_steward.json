{
  "schema": "ENTERPRISE_MATH_FOUNDATION_STEWARD_V1",
  "status": "ACTIVE",
  "effective": "2026-08-09",
  "role": "FOUNDATION_STEWARD",
  "mission": "Maintain and verify shared mathematical language, notation, formulas, theorem interfaces/status, and reusable tools; actively extract verified cross-route tools and structural logic back into foundation maintenance without becoming the primary investigator of newly exposed research problems.",
  "protocol": {
    "en": "docs/FOUNDATION_STEWARD_PROTOCOL.en.md",
    "zh": "docs/FOUNDATION_STEWARD_PROTOCOL.zh-CN.md"
  },
  "backflow": {
    "machine_router": "foundation_backflow.json",
    "protocol_en": "docs/FOUNDATION_BACKFLOW_LOOP.en.md",
    "protocol_zh": "docs/FOUNDATION_BACKFLOW_LOOP.zh-CN.md",
    "research_relay_issue": 82,
    "foundation_problem_issue": 164,
    "research_dispatch_issue": 240
  },
  "problem_set": {
    "repository": "awdawmip/enterprise-math",
    "issue": 164,
    "title": "[P0] Foundation Steward Problem Set / 底层维护高优先级问题集",
    "id_prefix": "FQ-",
    "priority_classes": ["P0-C", "P0-I", "P1-R", "P2-A"],
    "status_classes": ["OPEN", "CLAIMED", "RESEARCHING", "ANSWERED", "REJECTED", "CANONICALIZED"],
    "research_handoff_required": true,
    "steward_primary_investigator": false
  },
  "canonical_foundation_conventions": {
    "natural_numbers": {
      "nonnegative": "N = N_0 = {0,1,2,...}",
      "positive": "N_{>0} = {1,2,3,...}",
      "bare_N_includes_zero": true,
      "resolved_by": "FQ-20260809-002"
    },
    "root_collapse_exponents": {
      "primitive_nontrivial": "p >= 2",
      "positive_exponent_algebra": "p >= 1",
      "identity_case": "R_1 = C_1 = id",
      "resolved_by": "FQ-20260809-001"
    },
    "time_indexing": {
      "index_set": "N_0",
      "transition": "T_t : X_t -> X_{t+1}",
      "F_0": "id",
      "recurrence": "F_{t+1} = T_t o F_t",
      "expanded": "F_t = T_{t-1} o ... o T_0 for t >= 1",
      "merge_time": "min{t in N_0 : F_t(x) = F_t(y)} when nonempty",
      "resolved_by": "FQ-20260809-003"
    }
  },
  "direct_maintenance_when": [
    "mechanical_or_already_determined_by_canonical_evidence",
    "bilingual_or_reference_repair",
    "unambiguous_formula_transcription_fix",
    "stale_status_or_tool_routing_after_canonical_merge"
  ],
  "escalate_when": [
    "unresolved_mathematical_choice",
    "contradiction_or_unsoundness_risk",
    "missing_hypothesis_or_scope_uncertainty",
    "cross_route_incompatibility",
    "new_structural_pattern_worth_research",
    "prior_art_or_lineage_uncertainty",
    "tool_or_theorem_sufficiency_question"
  ],
  "research_backflow": {
    "enabled": true,
    "purpose": "Treat mature research routes as pressure tests of the common foundation and extract reusable structural results back into foundation maintenance.",
    "extraction_targets": [
      "minimal_sufficient_state",
      "minimal_repair_or_extension_data",
      "cross_route_invariant",
      "negative_boundary",
      "reusable_tool",
      "layering_law"
    ],
    "feedback_packet_fields": [
      "candidate_object_or_tool",
      "weakest_scope_hypotheses",
      "minimal_state",
      "minimal_repair_or_extension",
      "negative_boundary",
      "cross_route_evidence",
      "proof_status",
      "tool_surface",
      "prior_art_and_owner",
      "foundation_destination"
    ],
    "handling_classes": [
      "DIRECT_FOUNDATION_MAINTENANCE",
      "FOUNDATION_QUESTION",
      "APPLICATION_LOCAL_OR_NOT_READY"
    ],
    "closed_loop_router": "foundation_backflow.json",
    "does_not_create_global_barrier": true,
    "application_elegance_is_not_promotion_evidence": true,
    "wip_or_physical_interpretation_requires_independent_promotion_evidence": true
  },
  "verification_sources": [
    "docs/FOUNDATIONS.*",
    "docs/THEOREMS.*",
    "docs/PROBLEM_STATUS.*",
    "relevant canonical P/E theorem docs",
    "docs/RESEARCH_COMMON_SURFACE.*",
