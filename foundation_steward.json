{
  "schema": "ENTERPRISE_MATH_FOUNDATION_STEWARD_V1",
  "status": "ACTIVE",
  "effective": "2026-08-09",
  "role": "FOUNDATION_STEWARD",
  "mission": "Maintain and verify shared mathematical language, notation, formulas, theorem interfaces/status, and reusable tools without becoming the primary investigator of newly exposed research problems.",
  "protocol": {
    "en": "docs/FOUNDATION_STEWARD_PROTOCOL.en.md",
    "zh": "docs/FOUNDATION_STEWARD_PROTOCOL.zh-CN.md"
  },
  "problem_set": {
    "repository": "awdawmip/enterprise-math",
    "issue": 164,
    "title": "[P0] Foundation Steward Problem Set / 底层维护高优先级问题集",
    "id_prefix": "FQ-",
    "priority_classes": ["P0-C", "P0-I", "P1-R", "P2-A"],
    "status_classes": ["OPEN", "CLAIMED", "RESEARCHING", "ANSWERED", "REJECTED", "CANONICALIZED"],
    "research_handoff_required": true,
    "steward_primary_investigator": false
  },
  "direct_maintenance_when": [
    "mechanical_or_already_determined_by_canonical_evidence",
    "bilingual_or_reference_repair",
    "unambiguous_formula_transcription_fix",
    "stale_status_or_tool_routing_after_canonical_merge"
  ],
  "escalate_when": [
    "unresolved_mathematical_choice",
    "contradiction_or_unsoundness_risk",
    "missing_hypothesis_or_scope_uncertainty",
    "cross_route_incompatibility",
    "new_structural_pattern_worth_research",
    "prior_art_or_lineage_uncertainty",
    "tool_or_theorem_sufficiency_question"
  ],
  "verification_sources": [
    "docs/FOUNDATIONS.*",
    "docs/THEOREMS.*",
    "docs/PROBLEM_STATUS.*",
    "relevant canonical P/E theorem docs",
    "docs/RESEARCH_COMMON_SURFACE.*",
    "Research Relay Issue #82",
    "src/enterprise_math/ and tests/",
    "EnterpriseMath.lean and relevant imported Lean modules",
    "source commit/PR provenance",
    "prior-art/lineage records when relevant"
  ],
  "maintained_surfaces": {
    "language_notation": true,
    "definitions_domains_types_scales": true,
    "formula_integrity": true,
    "theorem_statement_hypothesis_status": true,
    "prose_executable_test_lean_consistency": true,
    "shared_theorem_tool_surface": true,
    "python_lean_reference_tools": true,
    "cross_route_foundation_invariants": true,
    "canonical_discovery_routing": true
  },
  "research_return_requires": [
    "proof_counterexample_or_exact_tool_evidence",
    "weakest_scope_hypotheses",
    "source_branch_commit_pr",
    "relation_to_existing_theorem_families",
    "prior_art_boundary_when_relevant",
    "canonical_change_recommendation"
  ],
  "common_research_surface": "research_common_surface.json",
  "scheduling_protocol": "docs/RESEARCH_SCHEDULING_PROTOCOL.en.md"
}
