    "registration_must_not_block_result_return": true,
    "durable_candidate_should_not_remain_orphaned": true
  },
  "proof_priority": {
    "factors": [
      "DOWNSTREAM_IMPACT",
      "EMPIRICAL_STABILITY",
      "STRUCTURAL_CENTRALITY",
      "EXPECTED_PROOF_COST",
      "FALSIFICATION_RISK"
    ],
    "interpretation": "High use increases urgency to prove or kill; it does not increase truth status."
  }
}
