{
  "schema": "ENTERPRISE_MATH_RESEARCH_TASK_PUBLICATION_CONTRACT_V1",
  "status": "ACTIVE_CANONICAL",
  "effective": "2026-08-25",
  "runtime_state_machine": "research_runtime_state_machine.json",
  "task_registry": "research_task_registry.json",
  "mandatory_template": "templates/RESEARCH_TASK_PUBLICATION_TEMPLATE.json",
  "publication_tool": "tools/research_task_registry.py",
  "cutover_checker": "tools/check_task_registry_cutover.py",
  "purpose": "Make every official new task a centrally registered runtime object so researcher/Driver task publication cannot create orphan work or lose valuable research residues.",
  "publisher_roles": [
    "RESEARCHER",
    "RESEARCH_DRIVER",
    "FOUNDATION_STEWARD"
  ],
  "publication_record_required_fields": [
    "task_id",
    "registry_key",
    "publication_id",
    "publication_contract",
    "template_version",
    "taskbook_path",
    "taskbook_blob_sha1",
    "publisher_role",
    "publisher_id",
    "published_at",
    "parent_objective_id",
    "origin_kind",
    "task_lineage",
    "registry_state",
    "claimable",
    "effective_priority",
    "effective_leverage",
    "priority_source",
    "research_value",
    "terminal_scope",
    "working_truth_granted",
    "canonical_promotion_granted"
  ],
  "core_invariants": [
    "OFFICIAL_TASK_EXISTS_ONLY_AFTER_CANONICAL_REGISTRY_RECORD",
    "NO_REGISTRY_RECORD_IMPLIES_NO_READY_CLAIM_OR_TASK_EXECUTION",
    "ALL_TASK_PUBLISHERS_USE_ONE_PUBLICATION_TEMPLATE",
    "RESEARCHER_MAY_PUBLISH_TASK_WITHOUT_DRIVER_APPROVAL",
    "TASK_PUBLICATION_DOES_NOT_GRANT_WORKING_TRUTH",
    "TASK_PUBLICATION_DOES_NOT_GRANT_FOUNDATION_OR_CANONICAL_PROMOTION",
    "TASK_PUBLICATION_DOES_NOT_GRANT_GLOBAL_PRIORITY_AUTHORITY",
    "EVERY_PUBLISHED_TASK_HAS_PARENT_OBJECTIVE_ID",
    "EVERY_PUBLISHED_TASK_PRESERVES_RESEARCH_VALUE_AND_NEXT_FRONTIER",
    "FREE_RESEARCH_TASK_PUBLICATION_REQUIRES_AUDITED_CANDIDATE_STATE",
    "CONTINUATION_PUBLICATION_REQUIRES_SUCCESSOR_GATE",
    "LEGACY_TASK_MAY_CONTINUE_EXISTING_EXECUTION_BUT_FRESH_REDISPATCH_REQUIRES_REGISTRATION",
    "LEGACY_SCHEDULER_DEFINITION_FILE_IS_FROZEN_AND_CANNOT_PUBLISH_NEW_TASKS"
  ],
  "researcher_publication": {
    "allowed": true,
    "driver_approval_required": false,
    "claimable_after_machine_publication_gate": true,
    "effective_priority_default": "P2",
    "effective_leverage_default": "MEDIUM",
    "publisher_may_request_priority": true,
    "publisher_priority_request_is_not_global_priority_authority": true,
    "driver_may_later_reprioritize": true
  },
  "driver_publication": {
    "allowed": true,
    "uses_same_template": true,
    "effective_priority": "PUBLISHER_DECLARED_AFTER_MACHINE_GATE",
    "effective_leverage": "PUBLISHER_DECLARED_AFTER_MACHINE_GATE"
  },
  "foundation_steward_publication": {
    "allowed": true,
    "uses_same_template": true,
    "kind_default": "GOVERNANCE",
    "does_not_grant_foundation_promotion": true
  },
  "free_research_publication": {
    "allowed_after_phase_b_audit": true,
    "allowed_candidate_states": [
      "AUDITED_AXIOM_CANDIDATE",
      "AUDITED_REPLACEMENT_CANDIDATE",
      "EXACT_NEGATIVE_OBSTRUCTION"
    ],
    "raw_phase_a_candidate_task_publication": false,
    "driver_intake_required_for_task_publication": false,
    "origin_kind_required": "FREE_AXIOM_CANDIDATE",
    "candidate_provenance_required": true
  },
  "task_researcher_residue_capture": {
    "allowed": true,
    "must_not_interrupt_current_task_only_to_seek_driver_permission": true,
    "publication_is_capture_not_current_task_switch": true,
    "research_value_required": true,
    "lineage_and_parent_task_must_remain_exact": true
  },
  "publication_transaction": [
    "CREATE_OR_UPDATE_TASKBOOK_FROM_UNIFIED_TEMPLATE",
    "RUN_CURRENT_POLICY_AND_LINEAGE_GATE",
    "WRITE_CANONICAL_REGISTRY_RECORD",
    "PIN_TASKBOOK_BLOB_IN_REGISTRY",
    "RUN_REGISTRY_ORPHAN_AUDIT",
    "RUN_LEGACY_SCHEDULER_CUTOVER_AUDIT",
    "ONLY_THEN_MARK_TASK_CLAIMABLE"
  ],
  "orphan_definition": "Any post-cutover task-like artifact, handoff, scheduler item, READY/CLAIM target or modified legacy task that lacks a canonical task registry record.",
  "orphan_handling": "FAIL_CLOSED_REGISTER_OR_CLASSIFY_AS_LEGACY_BEFORE_EXECUTION",
  "legacy_cutover": {
    "baseline_semantics": "The frozen research_scheduler.json Git blob recorded in research_task_registry.json defines the legacy baseline for already-existing executions.",
    "scheduler_definition_file_frozen": true,
    "scheduler_runtime_event_log_may_continue": true,
    "scheduler_file_may_publish_new_tasks": false,
    "new_or_modified_task_publication_path": "research_task_registry.json",
    "fresh_redispatch_requires_explicit_registry_record": true,
    "new_policy_review_pass_requires_explicit_registry_record": true,
    "legacy_baseline_does_not_authorize_new_or_modified_taskbooks": true,
    "cutover_check": "python tools/check_task_registry_cutover.py"
  },
  "priority_boundary": {
    "researcher_publication_default": "P2/MEDIUM",
    "researcher_can_record_requested_priority": true,
    "driver_retains_portfolio_reprioritization": true,
    "user_explicit_priority_instruction_overrides_default": true
  },
  "publication_completion_rule": "TASKBOOK_FILE_OR_HANDOFF_OR_LEGACY_SCHEDULER_ROW_ALONE_IS_NOT_NEW_TASK_PUBLICATION; REGISTRY_AND_CUTOVER_AUDITS_MUST_PASS"
}
