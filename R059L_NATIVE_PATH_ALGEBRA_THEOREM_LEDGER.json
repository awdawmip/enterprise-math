{"algebraic_classification":{"category_analogy":"PATH_CATEGORY / FREE-CATEGORY-LIKE ON THE DECLARED SYMMETRIC ADJACENCY RELATION","groupoid_claim":"REJECTED_BECAUSE_REVERSAL_DOES_NOT_CANCEL_EVENT_HISTORY","status":"PROVED_EXACT_COMPRESSION_AFTER_CONCRETE_LAWS","weakest_justified_statement":"Packets are objects and finite adjacency histories are morphism-like composable paths with zero-transition identities and associative concatenation. Reversal is an involutive order-reversing operation. PATH_COUNT is an additive N-grading. Reversal is not a cancellative inverse."},"forbidden_imports_consumed":false,"generation":"R059L","researcher_id":"EM-R059L-5F9D05","schema":"R059L_NATIVE_PATH_ALGEBRA_THEOREM_LEDGER_V1","stage":"STAGE_A","stage0_parent_head":"825c0cde2909d127e72d402d78bcdc7b9a40aec2","task_id":"RS-R059L-STAGE-A-NATIVE-PATH-ALGEBRA","taskbook_source_commit":"8a08f8efaf2e9498fd4a763e2ea1664da64602a8","theorems":[{"name":"identity laws","statement":"id_{x0}*gamma=gamma and gamma*id_{xn}=gamma","status":"PROVED_EXACT","theorem_id":"PA-T01"},{"name":"associativity","statement":"(gamma*eta)*zeta=gamma*(eta*zeta)","status":"PROVED_EXACT","theorem_id":"PA-T02"},{"name":"transition-count additivity","statement":"PATH_COUNT(gamma*eta)=PATH_COUNT(gamma)+PATH_COUNT(eta)","status":"PROVED_EXACT","theorem_id":"PA-T03"},{"name":"reversal involution and count invariance","statement":"rev(rev(gamma))=gamma; PATH_COUNT(rev(gamma))=PATH_COUNT(gamma)","status":"PROVED_EXACT","theorem_id":"PA-T04"},{"name":"reversal reverses composition order","statement":"rev(gamma*eta)=rev(eta)*rev(gamma)","status":"PROVED_EXACT","theorem_id":"PA-T05"},{"name":"reversal non-cancellation","statement":"PATH_COUNT(gamma*rev(gamma))=2*PATH_COUNT(gamma); >0 if gamma nonzero","status":"PROVED_EXACT","theorem_id":"PA-T06"},{"name":"endpoint incidence identity","statement":"DEPART_gamma(x)-ARRIVE_gamma(x)=1[x=x0]-1[x=xn]","status":"PROVED_EXACT","theorem_id":"PA-T07"},{"name":"global arrival/departure totals","statement":"sum ARRIVE=sum DEPART=PATH_COUNT","status":"PROVED_EXACT","theorem_id":"PA-T08"},{"name":"visit multiplicity identities","statement":"VISIT=ARRIVE+start_indicator=DEPART+end_indicator","status":"PROVED_EXACT","theorem_id":"PA-T09"},{"name":"C6 channel aggregation and endpoint identity","statement":"sum I=ARRIVE; sum O=DEPART; summed endpoint identity","status":"CONDITIONAL_ON_C6_EXTENSION","theorem_id":"PA-C6-01"}]}
