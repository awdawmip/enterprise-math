(set-option :timeout 18000)
(set-logic QF_LIA)
(define-fun mx ((a Int)(b Int)) Int (ite (>= a b) a b))
(define-fun mn ((a Int)(b Int)) Int (ite (<= a b) a b))
(define-fun p ((a Int)) Int (mx 0 a))
(define-fun ge ((a Int)(b Int)(c Int)(q Int)(u Int)) Bool (>= (+ (p (- a q)) (p (- b q)) (p (- c q))) (+ q (* 4 u) 1)))
(define-fun opp ((a Int)(b Int)(c Int)(d Int)(q Int)(r Int)) Bool (or (>= (mx (mx a b) (mx c d)) (+ (* 2 q) r)) (>= (mx (mx (+ a b) (+ c d)) (mx (+ a c) (+ b d))) (+ (* 3 q) r)) (>= (+ a b c d) (+ (* 4 q) r))))
(define-fun cross ((P Int)(X2 Int)(A Int)(X4 Int)(B Int)(C Int)(V Int)(q Int)(r Int)) Bool
(let ((t (- (p (- V q)) q)) (d (- (p (- (+ V C) q)) (* 2 q))) (l (p (- P q))))
(let ((K0 (p t)) (K1 (- (+ t A) q)) (C0 (mx (- (+ (p (- X2 q)) (p (- C q))) q) d)) (C1 (- (+ d A X2) q))
(J0 (mx 0 (mx (- l q) (+ t (p (- (+ l C) q)))))) (J1 (mx (- P (* 3 q)) (- (* 2 q))))
(E0 (+ t X4 B (mx (- C (* 2 q)) (- q)))) (E1 (+ t X4 B (mx (- (+ P C) (* 3 q)) (- (* 2 q))))))
(let ((lo (mx 0 (mx (- K1 r) (- C1 r)))) (hi (mn (- A 1) (- r 1 J1))))
(or (>= (mx K0 (mx C0 J0)) r) (> lo hi) (>= (mx (mx (+ C0 E0) (+ C1 -1 E1)) (mx (+ C0 E1 lo) (- (+ C1 -1 E0) hi))) (+ q (- P) (* 2 r))))))))
(declare-const q Int)(declare-const u Int)
(declare-const x1 Int)
(assert (>= x1 0))
(declare-const x2 Int)
(assert (>= x2 0))
(declare-const x3 Int)
(assert (>= x3 0))
(declare-const x4 Int)
(assert (>= x4 0))
(declare-const x5 Int)
(assert (>= x5 0))
(declare-const x6 Int)
(assert (>= x6 0))
(declare-const x7 Int)
(assert (>= x7 0))
(define-fun r () Int (+ (* 2 u) 1))
(assert (>= u 1))(assert (> q u))
(assert (ge x1 x3 (+ x5 x7) q u))
(assert (ge x2 x6 (+ x1 x5) q u))
(assert (ge x4 x3 (+ x2 x5) q u))
(assert (ge x7 x6 (+ x4 x5) q u))
(assert (opp x1 x3 x6 x4 q r))
(assert (opp x2 x3 x6 x7 q r))
(assert (cross x1 x2 x3 x4 x5 x6 x7 q r))
(assert (cross x2 x4 x6 x7 x5 x3 x1 q r))
(assert (or (and (<= q (* 2 u)) (< (+ x1 x2 x3 x4 x5 x6 x7) (+ (* 6 q) (* 4 u) 2))) (and (>= q (* 2 u)) (< (+ x1 x2 x3 x4 x5 x6 x7) (+ (* 4 q) (* 8 u) 2)))))
(check-sat)
