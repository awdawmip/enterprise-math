  "reproduction": "function audit(tree,base,R0){\nconst R=R0.map(x=>x.map(BigInt)),P=base.predForms.map(x=>x.map(BigInt)),T=base.terms.map(([i,g])=>[i,BigInt(g)]),E=[[17,1,0],[39,0,0],[17,0,1],[22,1,0],[0,1,1],[22,0,1]].map(x=>x.map(BigInt));\nconst dot=(a,b)=>a.reduce((s,x,i)=>s+x*b[i],0n), abs=a=>a<0n?-a:a,gcd=(a,b)=>{a=abs(a);b=abs(b);while(b)[a,b]=[b,a%b];return a},norm=a=>{let d=a.reduce(gcd,0n);return d?a.map(x=>x/d):a},sum=a=>[0,1,2].map(i=>a.reduce((s,x)=>s+x[i],0n));\nlet L=new Map();function add(a){a=norm(a);if(!a.some(x=>x>0n)||!a.some(x=>x<0n))return;if(a.find(x=>x!==0n)<0n)a=a.map(x=>-x);L.set(a.join(),a)}\nR.forEach(add);function visit(t){if(t.leaf)return;add(P[t.q]);visit(t.yes);visit(t.no)}visit(base.tree);for(let i=0;i<T.length;i++)for(let j=i+1;j<T.length;j++){let [a,g]=T[i],[b,h]=T[j];add(E[b].map((x,k)=>g*x-h*E[a][k]))}\nfunction arrange(lines){let cells=[[[1n,0n,0n],[0n,1n,0n],[0n,0n,1n]]];for(let l of lines){let next=[];for(let c of cells){let s=c.map(x=>dot(l,x));if(!s.some(x=>x>0n)||!s.some(x=>x<0n)){next.push(c);continue}let y=[],z=[];for(let i=0;i<c.length;i++){let j=(i+1)%c.length;if(s[i]>=0n)y.push(c[i]);if(s[i]<=0n)z.push(c[i]);if(s[i]*s[j]<0n){let w=norm(c[i].map((x,k)=>abs(s[j])*x+abs(s[i])*c[j][k]));y.push(w);z.push(w)}}next.push(y,z)}cells=next}let pts=new Map();function put(x){if(x.every(v=>v>0n)){x=norm(x);pts.set(x.join(),x)}}for(let c of cells){put(sum(c));for(let i=0;i<c.length;i++){put(c[i]);put(sum([c[i],c[(i+1)%c.length]]))}}return {cells:cells.length,pts:[...pts.values()]}}\nconst signs=x=>R.map(r=>{let z=dot(r,x);return z>0n?1:z<0n?-1:0});\nfunction walk(s){let t=tree,fs=new Set(),path=\"\",j=0,zero=false;while(!t.out){let [a,b,c]=t.q;fs.add(a);if(b>=0){fs.add(b);j++}let v=s[a]*c*(b<0?1:s[b]);zero||=v===0;path+=v>0?\"Y\":\"N\";t=v>0?t.yes:t.no}return {out:t.out,path,j,f:fs.size,zero}}\nlet A=arrange(L.values()),B=arrange(R),ties=0,zeros=0;for(let x of A.pts){let t=base.tree;while(!t.leaf)t=dot(P[t.q],x)>0n?t.yes:t.no;let [i,n]=t.leaf,z=walk(signs(x)),[nn,m]=z.out,k=Math.log2(m);if(n!==nn||!Number.isInteger(k))throw Error(\"near \"+x);let [a,g]=T[i],[b,h]=T[k];if(g*dot(E[b],x)!==h*dot(E[a],x))throw Error(\"term \"+x);ties+=i!==k;zeros+=z.zero}\nlet pat=[...new Map(B.pts.map(x=>{let s=signs(x);return [s.join(),s]})).values()],all=(1n<<BigInt(pat.length))-1n,pos=R.map(()=>0n),neg=R.map(()=>0n),hist={},depth={},leaves=new Set(),outs=new Set(),maxF=0,maxJ=0;\npat.forEach((s,i)=>{s.forEach((v,j)=>{if(v>0)pos[j]|=1n<<BigInt(i);if(v<0)neg[j]|=1n<<BigInt(i)});let z=walk(s);hist[z.j]=(hist[z.j]||0)+1;depth[z.path.length]=(depth[z.path.length]||0)+1;leaves.add(z.path);outs.add(z.out.join());maxF=Math.max(maxF,z.f);maxJ=Math.max(maxJ,z.j)});\nfunction mask([i,j,s]){return j<0?(s>0?pos[i]:neg[i]):s>0?(pos[i]&pos[j])|(neg[i]&neg[j]):(pos[i]&neg[j])|(neg[i]&pos[j])}\nconst Q=[];for(let i=0;i<R.length;i++){for(let s of [1,-1])Q.push([i,-1,s]);for(let j=i;j<R.length;j++)for(let s of [1,-1])if(j!==i||s===1)Q.push([i,j,s])}\nconst opts=Q.map(q=>({q,m:mask(q),f:(1n<<BigInt(q[0]))|(q[1]<0?0n:1n<<BigInt(q[1])),j:+(q[1]>=0)}));let nodes=0,mandatory=0,paths=[],perNode={};\nfunction pop(x){let n=0;while(x){x&=x-1n;n++}return n}\nfunction rec(t,S,p,chain){if(t.out){paths.push({p,chain});return}nodes++;let y=S&mask(t.q),n=S^y;if(!y||!n)throw Error(\"empty\");let o=opts.filter(q=>{let a=q.m&S;return a===y||a===n});if(!o.length)throw Error(\"no equivalent\");mandatory+=o.every(q=>q.j===1);perNode[p||\"ROOT\"]={options:o.length,linear:o.filter(q=>!q.j).length};rec(t.yes,y,p+\"Y\",[...chain,o]);rec(t.no,n,p+\"N\",[...chain,o])}rec(tree,all,\"\",[]);\nfunction antichain(xs){let out=[];for(let x of [...new Set(xs)].sort((a,b)=>pop(a)-pop(b))){if(!out.some(y=>(x&y)===y))out.push(x)}return out}\nlet factorLower=0,jointLower=0,fw=null,jw=null;for(let {p,chain} of paths){let cs=[0n],mj=0;for(let o of chain){cs=antichain(cs.flatMap(c=>o.map(q=>q.f|c)));mj+=o.every(q=>q.j===1)}let mf=Math.min(...cs.map(pop));let witness={path:p,minDistinct:mf,minJoint:mj,options:chain.map(o=>o.map(q=>q.q))};if(mf>factorLower){factorLower=mf;fw=witness}if(mj>jointLower){jointLower=mj;jw=witness}}\nreturn {common:{lines:L.size,polygons:A.cells,positiveFaces:A.pts.length,differentEqualTerm:ties,zeroQuery:zeros,mismatches:0},support:{polygons:B.cells,positiveFaces:B.pts.length,patterns:pat.length,hist,depth,feasibleLeaves:leaves.size,distinctOutputs:outs.size,maxFactors:maxF,maxJoint:maxJ},fixed:{nodes,mandatoryQuadraticNodes:mandatory,queries:Q.length,factorLower,jointLower,factorWitness:fw,jointWitness:jw,perNode}}\n}"
