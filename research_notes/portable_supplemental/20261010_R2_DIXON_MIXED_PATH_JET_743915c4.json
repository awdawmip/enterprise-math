  "checker": "from fractions import Fraction as Q\nimport json\n\ndef family(m,a,d):\n    b=Q(1); f=Q(0)\n    for j in range(m+1):\n        if j: b*=Q(j-1-m)/(d+j-1)\n        f+=b*a/(a+j)\n    return f\n\ndef jets(m,a):\n    d=m+a+1; b=Q(1); h=Q(0); h2=Q(0)\n    f=n=k=fa=faa=fad=Q(0)\n    for j in range(m+1):\n        if j:\n            b*=Q(j-1-m)/(d+j-1)\n            h+=1/(d+j-1); h2+=1/(d+j-1)**2\n        t=b*a/(a+j)\n        f+=t; n-=t*h; k+=t*(h*h+h2)\n        fa+=b*j/(a+j)**2\n        faa-=2*b*j/(a+j)**3\n        fad-=b*j*h/(a+j)**2\n    cp=cpp=Q(0)\n    for r in range(m):\n        u=a+2*r+2; v=a+2*r+1\n        cp+=1/u-1/v+a*(-1/u**2+1/v**2)\n        cpp+=2*(-1/u**2+1/v**2)+2*a*(1/u**3-1/v**3)\n    assert cp==fa+n\n    assert cpp==faa+2*fad+k\n    return f,n,k,cp,cpp,fad+k,fad,faa\n\ndef residue(q,mod):\n    return q.numerator*pow(q.denominator,-1,mod)%mod\n\ndef prime(p):\n    return p>=2 and all(p%d for d in range(2,int(p**.5)+1))\n\nchecks=0\nfor m in range(1,7):\n    for a in (Q(-1,3),Q(2,7),Q(3,2),Q(2)):\n        jets(m,a); checks+=2\n\nrows=[]\nfor p in range(7,101):\n    if p%6!=1 or not prime(p): continue\n    m=(p-1)//6; a=Q(-1,3); d=m+a+1\n    c,n,k,cp,cpp,np,fad,faa=jets(m,a)\n    for alpha,beta in ((1,0),(1,1),(1,-2),(2,3),(-1,2)):\n        s=family(m,a+p*alpha,d+p*(alpha+beta))\n        linear=alpha*cp+beta*n\n        quadratic=Q(alpha*alpha,2)*cpp+alpha*beta*np+Q(beta*beta,2)*k\n        assert residue(s-c-p*linear-p*p*quadratic,p**3)==0\n        assert residue((s-c)/p-linear-p*quadratic,p*p)==0\n        l=residue(linear,p*p); r=l%p; carry=(l-r)//p\n        div=residue((s-c)/p,p*p)\n        second=(div-div%p)//p\n        assert div%p==r and second==(carry+residue(quadratic,p))%p\n        tangent=family(m,a+p*alpha,d+p*alpha)\n        normal_second=alpha*beta*np+Q(beta*beta,2)*k\n        assert residue(s-tangent-p*beta*n-p*p*normal_second,p**3)==0\n        curve_residues=[]\n        for gamma in (1,-1):\n            curve=family(m,a+p*alpha,d+p*(alpha+beta)+p*p*gamma)\n            assert residue(curve-s-p*p*gamma*n,p**3)==0\n            curve_residues.append(dict(gamma=gamma,second_order_curve_change=residue(gamma*n,p)))\n        shortcut=Q(alpha*alpha,2)*cpp\n        rows.append(dict(p=p,m=m,alpha=alpha,beta=beta,\n            linear_mod_p2=l,canonical_first=r,linear_carry=carry,\n            quadratic_mod_p=residue(quadratic,p),canonical_second=second,\n            mixed_jet_mod_p=residue(np,p),normal_hessian_mod_p=residue(k,p),\n            omitted_normal_quadratic_mod_p=residue(quadratic-shortcut,p),\n            second_order_curve_changes=curve_residues,\n            remainder_mod_p3=0))\n        checks+=6\nout=dict(status='PASS',rational_jet_identity_checks=48,\n    primes=sorted(set(x['p'] for x in rows)),direction_checks=len(rows),\n    total_assertions=checks,rows=rows)\nwith open('mixed_jet_result.json','w') as f: json.dump(out,f,indent=2)\nprint(json.dumps({k:v for k,v in out.items() if k!='rows'}))\nprint(json.dumps([x for x in rows if x['p']==13]))\n",
