  "read_renews_lifetime": false,
  "background_refresh": false,
  "retention": "KEEP_VERSIONED_EVIDENCE_UNLESS_DELETION_OR_RIGHTS_RESTRICTION",
  "negative_ttl_seconds": 86400,
  "classes": {
    "company_identity": {
      "ttl_seconds": 15552000,
      "scope": "current",
      "description": "统一社会信用代码、成立日期等稳定标识；不含现名、现股东"
    },
    "company_registration": {
      "ttl_seconds": 2592000,
      "scope": "current",
      "description": "公司名称、注册资本、经营范围、登记地址与登记状态"
    },
    "ownership_governance": {
      "ttl_seconds": 604800,
      "scope": "current",
      "description": "股东、持股比例、控制链、法定代表人与董监高"
    },
    "litigation_enforcement": {
      "ttl_seconds": 86400,
      "scope": "current",
      "description": "涉诉、执行、失信、限制消费、破产与权利负担状态"
    },
    "law_validity": {
      "ttl_seconds": 604800,
      "scope": "current",
      "description": "法律效力、修订或废止状态；不等于已完成官方时点适法核验"
    },
    "case_search": {
      "ttl_seconds": 604800,
      "scope": "current",
      "description": "同库、同条件、同时间范围的案例检索结果"
    },
    "securities_basic": {
      "ttl_seconds": 604800,
      "scope": "current",
      "description": "证券及发行人基础资料；不是实时行情"
    },
    "financial_latest": {
      "ttl_seconds": 2592000,
      "scope": "current",
      "description": "最新报告目录和可修订财务数据，不含固定版本报告"
    },
    "macro_revisable": {
      "ttl_seconds": 2592000,
      "scope": "current",
      "description": "同国家、指标、期间、单位和修订口径的宏观数据"
    },
    "news": {
      "ttl_seconds": 21600,
      "scope": "current",
      "description": "同查询时段新闻标题、链接和许可摘要"
    },
    "versioned_original": {
      "ttl_seconds": null,
      "scope": "fixed_version",
      "description": "指定版本公告、法规或裁判原文、已发布历史报告及论文原文/许可片段；保留版本ID、读取范围和预印本状态，不证明当前状态或已读全文"
    },
    "realtime_market": {
      "ttl_seconds": 0,
      "scope": "current",
      "description": "实时行情不以旧值替代，使用适用的已授权实时工具"
    },
    "literature_search": {
      "ttl_seconds": 604800,
      "scope": "current",
      "description": "同来源、检索式、日期范围和版本条件的学术文献检索列表及其元数据；不是已读论文全文"
    },
    "research_report_search": {
      "ttl_seconds": 604800,
      "scope": "current",
      "description": "同来源、主题、机构和期间条件的研报检索列表；固定报告/片段另按版本保存"
    },
    "consensus_estimates": {
      "ttl_seconds": 86400,
      "scope": "current",
      "description": "公司、指标、预测期间和统计口径明确的一致预期及可修订预测；不冒充历史时点快照"
    },
    "industry_high_frequency": {
      "ttl_seconds": 86400,
      "scope": "current",
      "description": "可更新的产业日/周等高频数据；保留指标、频率、单位与修订口径；固定历史版本另行标识"
    },
    "indicator_catalog": {
      "ttl_seconds": 2592000,
      "scope": "current",
      "description": "指标名称、代码、单位、频率及可用期间等目录元数据；不是实际指标值"
    }
  },
