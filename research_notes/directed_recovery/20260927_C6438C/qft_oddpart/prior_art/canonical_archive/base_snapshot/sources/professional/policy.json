  "capability_boundary": "Operation availability does not certify arbitrary fields; company_basic is not a shareholder, enforcement or property-register API.",
  "transport_protocol": "knowledge/procedures/KIMI_GITHUB_BATCH_QUERY_20260921.md",
  "authority_boundary": "System-required verification and current explicit source restrictions take precedence; disclose any necessary exception.",
  "company_dossier_protocol": "knowledge/procedures/COMPANY_DOSSIER_AND_RELATIONSHIP_20260921.md",
  "max_tasks_per_conversation_turn": 3,
  "company_profile_verified_components": [
    "basic",
    "shareholders",
    "personnel"
  ],
  "company_profile_integration_only_components": [
    "investments"
  ],
  "max_tasks_per_deep_research_turn": 10,
  "query_mode_policy": {
    "request_field": "request.mode",
    "default": "standard",
    "max_tasks_per_turn": {
      "standard": 3,
      "deep_research": 10
    },
    "deep_research_trigger": "current_user_request.contains_exact(\"深入研究\")",
    "scope": [
      "conversation_id",
      "turn_id"
    ],
    "lock_mode": "FIRST_ADMITTED_BATCH",
    "subagents_share_budget": true
  },
  "automatic_routing_protocol": "knowledge/procedures/PROFESSIONAL_DATABASE_AUTO_ROUTING_20260921.md",
  "operation_verification": {
    "checked_at_date": "2026-09-21",
    "meaning": "A non-empty provider sample and actual fields were received; not a guarantee of facts, complete coverage, arbitrary entitlements or full text.",
    "limited_cases": {
      "wind/indicator_series:C1925068": {
        "state": "BLOCKED_PERMISSION",
        "meaning": "Indicator catalog found; values inaccessible under tested entitlement. Other GDP scope returned non-empty values."
      },
      "tianyancha/enforcement": {
        "state": "EMPTY_OR_IDENTITY_UNRESOLVED",
        "production_enabled": false,
        "meaning": "Probe returned upstream EMPTY_DATA error; not a verified no-risk result or a formally enabled query operation."
      },
      "sp_data/transcripts": {
        "scope": "SELECTED_RECORDS_OR_EXCERPTS",
        "full_transcript_verified": false
      },
      "sp_data/transactions": {
        "scope": "SELECTED_RECORDS",
        "complete_transaction_universe_verified": false
      },
      "gildata/research_report": {
        "scope": "REPORT_EXCERPTS",
        "full_pdf_verified": false
      },
      "arxiv/paper_search": {
        "scope": "BIBLIOGRAPHIC_AND_ABSTRACT",
        "full_text_async_implemented": false
      },
      "scholar/paper_search": {
        "scope": "BIBLIOGRAPHIC_AND_ABSTRACT_PREVIEW",
        "full_text_verified": false
      }
    }
  },
