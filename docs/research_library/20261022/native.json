      "author": "EM-FREE-185026",
      "reviewer": "EM-FREE-CF1677",
      "model": "Heartbeat X6的完整signed Z^6 Cell torsor内，固定锚点a的有限盒B；signed chart不是最终Cell地址。",
      "assumptions": [
        "B={a+z:z∈{-1,0,1}^6}，全部729个Cell保留。",
        "p_i=a+e_i；O为保留轴标签和联合关联的六元组，使用既有component-quadratic读出。",
        "静态Cell-center观察，不声明路径、packet或动力学未来语言。"
      ],
      "formulas": [
        {
          "id": "quadratic_observer",
          "expression": "Q(z)=Σ_{i=1}^6 z_i²; O_i(z)=d6(a+z,a+e_i)²=Q(z)+1−2z_i"
        },
        {
          "id": "fiber_necessity",
          "expression": "O(z)=O(w) ⇒ w=z+t(1,…,1), t(Σ_i z_i+3t−1)=0"
        },
        {
          "id": "all_doubletons",
          "expression": "u_A=−1_A; v_A=1_{A^c}, |A|=2; O(u_A)=O(v_A), Q(u_A)=2,Q(v_A)=4"
        },
        {
          "id": "cardinality",
          "expression": "15 doubletons + 699 singletons; |O(B)|=714; (O,Q) is injective on B"
        }
      ],
      "conclusion": "O(z)=O(w)当且仅当z=w，或无序对{z,w}恰为某唯一二元轴集A对应的{u_A,v_A}。其余Cell均为单点纤维；附加锚点二次距离Q恰好拆开全部碰撞。",
      "limits": [
        "不证明任意传感器设计中七个读出的最小性。",
        "不适用于无标签读出、多重集、独立边缘、任意盒或完整packet身份。",
        "O纤维不等于整个global-diagonal轨道；不授权其他未来操作的商。",
        "不推出物理传感、传播、Euclidean角度或力学定律。"
