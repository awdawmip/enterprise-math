import Mathlib.Data.Nat.Basic
import Mathlib.Tactic

namespace EnterpriseMath.PrimePowerQuotientTriangle

/-- Finite quotient-scale return generated by a positive integer action label. -/
def quotient (a n : ℕ) : ℕ := n / a

/-- Successive quotient returns multiply their action labels. -/
theorem quotient_comp (a b n : ℕ) :
    quotient b (quotient a n) = quotient (a * b) n := by
  simp [quotient, Nat.div_div_eq_div_mul]

/-- Signless edge defect on the quotient edge labelled by `a`. -/
def defect (a : ℕ) (f : ℕ → ℝ) (n : ℕ) : ℝ :=
  f n + f (quotient a n)

/--
Every pair of commuting quotient histories forms an odd triangle: the direct
`a*b` edge has odd length, while the route through `a` and then `b` has even
length.  Their signless edge defects recover twice the initial value.
-/
theorem oddTriangle_general (a b : ℕ) (f : ℕ → ℝ) (n : ℕ) :
    2 * f n =
      defect a f n + defect (a * b) f n - defect b f (quotient a n) := by
  simp only [defect]
  rw [quotient_comp]
  ring

/-- Local signless coercivity supplied by every quotient-history odd triangle. -/
theorem oddTriangle_general_sq_coercive
    (a b : ℕ) (f : ℕ → ℝ) (n : ℕ) :
    4 * (f n) ^ 2 ≤
      3 * ((defect a f n) ^ 2 + (defect (a * b) f n) ^ 2 +
        (defect b f (quotient a n)) ^ 2) := by
  let x := defect a f n
  let y := defect (a * b) f n
  let z := defect b f (quotient a n)
  have h : 2 * f n = x + y - z := by
    simpa [x, y, z] using oddTriangle_general a b f n
  calc
    4 * (f n) ^ 2 = (2 * f n) ^ 2 := by ring
    _ = (x + y - z) ^ 2 := by rw [h]
    _ ≤ 3 * (x ^ 2 + y ^ 2 + z ^ 2) := by
      nlinarith [sq_nonneg (x - y), sq_nonneg (x + z), sq_nonneg (y + z)]
    _ = 3 * ((defect a f n) ^ 2 + (defect (a * b) f n) ^ 2 +
        (defect b f (quotient a n)) ^ 2) := by rfl

/-- Quotient-scale return generated by the prime power `2`. -/
def q2 (n : ℕ) : ℕ := quotient 2 n

/-- Quotient-scale return generated by the prime power `4`. -/
def q4 (n : ℕ) : ℕ := quotient 4 n

/-- Two successive quotient-by-two returns equal one quotient-by-four return. -/
theorem q2_q2_eq_q4 (n : ℕ) : q2 (q2 n) = q4 n := by
  simpa [q2, q4] using quotient_comp 2 2 n

/-- Signless edge defect on the quotient-by-two edge. -/
def defect2 (f : ℕ → ℝ) (n : ℕ) : ℝ := defect 2 f n

/-- Signless edge defect on the quotient-by-four edge. -/
def defect4 (f : ℕ → ℝ) (n : ℕ) : ℝ := defect 4 f n

/-- Specialized `2-2-4` odd-triangle identity. -/
theorem oddTriangle_identity (f : ℕ → ℝ) (n : ℕ) :
    2 * f n = defect2 f n + defect4 f n - defect2 f (q2 n) := by
  simpa [defect2, defect4, q2] using oddTriangle_general 2 2 f n

/-- An exact sign reversal on both prime-power return families is necessarily zero. -/
theorem no_exact_minus_one_mode
    (f : ℕ → ℝ)
    (h2 : ∀ n, defect2 f n = 0)
    (h4 : ∀ n, defect4 f n = 0) :
    ∀ n, f n = 0 := by
  intro n
  have h := oddTriangle_identity f n
  rw [h2 n, h4 n, h2 (q2 n)] at h
  linarith

/-- Specialized local signless Poincare/coercivity inequality. -/
theorem oddTriangle_sq_coercive (f : ℕ → ℝ) (n : ℕ) :
    4 * (f n) ^ 2 ≤
      3 * ((defect2 f n) ^ 2 + (defect4 f n) ^ 2 +
        (defect2 f (q2 n)) ^ 2) := by
  simpa [defect2, defect4, q2] using
    oddTriangle_general_sq_coercive 2 2 f n

end EnterpriseMath.PrimePowerQuotientTriangle
