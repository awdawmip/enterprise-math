{
  "schema": "ENTERPRISE_MATH_REVIEW_EVIDENCE_CONTRACT_V1",
  "status": "ACTIVE_CANONICAL_AS_NEEDED_REVIEW_V1_2",
  "effective": "2026-11-13",
  "authority_reducer": "research_review_evidence.py",
  "append_only_store_implementation": "research_review_evidence_store.py",
  "store_compatibility_shim": "control_plane/research_review_evidence_store.py",
  "runtime_consumer": "tools/research_result_records.py",
  "review_store": "research_result_reviews/<result-id>/<review-id>.json",
