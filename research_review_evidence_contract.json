  "synthesis_store": "research_review_syntheses/<result-id>/<synthesis-id>.json",
  "ci_gate": "python research_review_evidence.py audit",
  "purpose": "Preserve multiple independent Driver reviews as immutable evidence and forbid reviewed_at/latest-review ordering from becoming task-control authority.",
  "core_invariants": [
    "MULTIPLE_DRIVER_REVIEWS_ARE_RETAINED_EVIDENCE_NOT_AN_ERROR",
    "MULTIPLE_DRIVER_REVIEWS_ARE_NOT_RESOLVED_BY_LATEST_TIMESTAMP_WINS",
    "APPEND_ONLY_REVIEW_STORAGE_IS_NOT_OPERATIONAL_DISPOSITION_AUTHORITY",
    "REPOSITORY_ROOT_STORAGE_SEMANTICS_SURVIVE_INTERNAL_COMPATIBILITY_SHIMS",
    "ONE_REVIEW_RETAINS_THE_LOW_BURDEN_HISTORICAL_FLOW",
    "RUNTIME_REDUCER_VALIDATES_SCHEMA_EXACT_SET_HASH_UNIQUENESS_AND_TERMINAL_CONSISTENCY_BEFORE_USING_CONTROL_RECORDS",
    "REVIEW_SYNTHESIS_SINGLE_VALUES_OPERATIONAL_DISPOSITION_WITHOUT_DELETING_REJECTING_OR_DOWNRANKING_SOURCE_REVIEWS",
    "A_NEW_REVIEW_CHANGES_THE_REVIEW_SET_HASH_AND_INVALIDATES_OLD_SYNTHESIS_FOR_CURRENT_CONTROL_WITHOUT_DELETING_HISTORY",
    "OFFLINE_AUDIT_IS_REQUIRED_BUT_IS_NOT_A_SUBSTITUTE_FOR_RUNTIME_FAIL_CLOSED_VALIDATION",
    "REVIEW_MULTIPLICITY_DOES_NOT_GRANT_WORKING_TRUTH_FOUNDATION_OR_CANONICAL_PROMOTION",
    "REFERENCE_PASSES_HAVE_NO_REQUIRED_COUNT_OR_ORDER",
    "EXACT_SET_SYNTHESIS_RECORDS_NOT_PERFORMED_IF_NO_CROSSCHECK",
    "UNREVIEWED_RESEARCH_CAN_CONTINUE_WITHOUT_FALSE_ACCEPTANCE"
  ],
  "single_review_extra_control_objects": 0,
  "multiple_review_flow": [
    "OPTIONAL_EXACT_SET_INTAKE",
    "OPTIONAL_REFERENCE_PASSES_IN_ANY_ORDER",
    "EXPLICIT_EXACT_SET_SYNTHESIS_WHEN_A_SINGLE_OPERATIONAL_JUDGMENT_IS_NEEDED"
  ],
  "terminal_dispositions": [
    "ACCEPTED",
    "REJECTED",
    "PARKED",
    "CLOSED",
    "SUPERSEDED"
  ],
  "nonterminal_dispositions": [
    "RETURN_TO_OWNER",
    "REQUEST_REPLICATION",
    "REQUEST_REVISION"
  ],
  "latest_review_wins": false,
  "all_reviews_retained": true,
  "working_truth_granted": false,
  "foundation_authority_granted": false,
