      "user_requested_stop_pause_review_or_wait",
      "parent_hard_blocker",
      "platform_or_tool_hard_limit",
      "independent_safe_work_exhausted",
      "same_action_repeated_without_state_change",
      "supported_alternative_available",
      "parent_state_recomputed_without_change",
      "executable_next_actions"
    ],
    "optional_inputs": [
      "continuation_lease_active"
    ],
    "transitions": [
      "FINAL_ALLOWED",
      "FINAL_ALLOWED_WITH_BLOCKER",
      "FINAL_ALLOWED_WITH_LIMIT",
      "EXECUTE_NEXT_ACTION",
      "SWITCH_STRATEGY",
      "RECOMPUTE_PARENT_STATE",
      "CONTROL_STATE_INCONSISTENT"
    ],
    "final_allowed_transitions": [
      "FINAL_ALLOWED",
      "FINAL_ALLOWED_WITH_BLOCKER",
      "FINAL_ALLOWED_WITH_LIMIT"
    ],
    "base_rule": "PARENT_INCOMPLETE_AND_EXECUTABLE_ACTION_EXISTS_IMPLIES_FINAL_FORBIDDEN_REGARDLESS_OF_CONTINUATION_LEASE"
  },
  "continuation_lease": {
    "activation_semantics": [
      "continue",
      "keep going",
      "do not stop",
      "until no further progress",
      "until satisfied",
      "solve blocker and continue",
      "multi-step parent completion criterion"
    ],
    "state": "ACTIVE_UNTIL_PARENT_CRITERION_MET_OR_USER_REVOKES",
    "base_liveness_dependency": false,
    "terminal_block_or_limit_consumes_lease": false,
    "cannot_be_consumed_by": [
      "STAGE_TERMINAL_VERDICT",
      "ROUTE_CLOSURE",
      "SEMANTIC_CHECKPOINT",
      "JOURNAL_WRITE",
      "PR_OR_BRANCH_SUBFLOW",
      "PUBLICATION_SUBFLOW"
    ]
  },
  "blocked_subflow_semantics": {
    "blocked_subflow_is_parent_blocker": false,
    "parent_block_requires": "NO_EXECUTABLE_INDEPENDENT_OR_DOWNSTREAM_SAFE_WORK_REMAINS",
    "local_block_with_other_work": "EXECUTE_NEXT_ACTION",
    "terminal_block_requires_independent_safe_work_exhausted": true
  },
  "loop_safety": {
    "same_action_without_state_change_must_not_repeat": true,
    "if_supported_alternative_available": "SWITCH_STRATEGY",
    "if_no_alternative_and_parent_not_recomputed": "RECOMPUTE_PARENT_STATE",
    "if_parent_recomputed_without_change": "CONTROL_STATE_INCONSISTENT",
    "if_safe_work_claimed_remaining_but_recompute_produces_no_action": "CONTROL_STATE_INCONSISTENT",
    "max_identical_no_progress_retry_without_transition": 0
  },
  "nonterminal_boundaries": [
    "TOOL_SUCCESS",
    "RECOVERABLE_TOOL_ERROR_WITH_ALTERNATIVE",
    "SEMANTIC_CHECKPOINT",
    "JOURNAL_WRITE",
    "BRANCH_OR_PR_METADATA_BOUNDARY",
    "MERGEABLE_OR_CI_OR_REVIEW_PENDING_NONBLOCKING",
    "STAGE_PASS_FAIL_OR_CLOSE",
    "DRIVER_VERDICT",
    "PROGRESS_UPDATE",
    "PUBLICATION_COMPLETE",
    "LOCAL_SOFT_BLOCK_WITH_INDEPENDENT_WORK_AVAILABLE"
  ],
  "stage_rule": {
    "pass_is_not_successor_trigger": true,
    "stage_terminal_requires_same_turn_successor_gate_evaluation": true,
    "local_close_may_happen_without_successor": true,
