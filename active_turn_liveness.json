    "REPEATING_IDENTICAL_NO_PROGRESS_ACTION_WITHOUT_STATE_CHANGE"
  ],
  "forbidden_state": "WAITING_FOR_CONTINUE_WHEN_CONTINUE_ADDS_NO_INFORMATION",
  "enforcement_boundary": "REPOSITORY_CANONICAL_EVALUATOR_AND_REGRESSION_GUARD; PRODUCT_RUNTIME_MUST_INVOKE_OR_REIMPLEMENT_THIS_DECISION_TO_PHYSICALLY_BLOCK_A_FINAL_RESPONSE"
}
