{
  "schema": "ENTERPRISE_MATH_ACTIVE_TURN_LIVENESS_V1",
  "status": "ACTIVE_CANONICAL",
  "effective": "2026-08-22",
  "unified_runtime_state_machine": "research_runtime_state_machine.json",
  "scheduler_liveness_contract": "research_scheduler_liveness.json",
  "scope": [
    "FREE_AXIOM_DISCOVERY",
    "TASK_RESEARCH",
    "RESEARCH_DRIVER",
    "FOUNDATION_STEWARD",
    "REMOTE_AND_PUBLICATION_SUBFLOWS"
  ],
  "execution_stack": [
    "PARENT_USER_OBJECTIVE",
    "CURRENT_SUBFLOW",
    "NEXT_EXECUTABLE_ACTION"
  ],
  "core_invariants": [
    "SUBFLOW_COMPLETE_IS_NOT_USER_OBJECTIVE_COMPLETE",
    "DETERMINISTIC_NEXT_STEP_EXISTS_IMPLIES_CONTINUE_IN_SAME_TURN",
    "PROGRESS_UPDATE_IS_NOT_A_SYNCHRONIZATION_BARRIER",
    "TOOL_RESULT_RECEIVED_IMPLIES_RESUME_PARENT_TASK",
    "CHECKPOINT_PERSISTED_IMPLIES_RESUME_PARENT_TASK",
    "PENDING_NONBLOCKING_IMPLIES_CONTINUE_PARENT_TASK",
    "LOCAL_ROUTE_CLOSURE_DOES_NOT_CLOSE_PARENT_GOAL",
    "USER_WAKEUP_MESSAGE_MUST_NOT_BE_REQUIRED_WHEN_IT_ADDS_NO_INFORMATION"
  ],
  "runtime_enforcement": {
    "snapshot_builder": "tools/research_runtime.py::build_runtime_snapshot",
    "pre_final_gate": "tools/research_runtime.py::pre_final_gate",
    "fail_closed": true,
    "rule": "PARENT_OBJECTIVE_OPEN_WITHOUT_PROVED_TERMINAL_CONDITION -> FINAL_DENIED",
    "known_next_action": "EXECUTE_NEXT_ACTION_IN_SAME_TURN",
    "unknown_next_action": "RESOLVE_NEXT_ACTION_OR_TERMINAL_BLOCK",
    "allowed_terminal_reasons": [
      "PARENT_USER_OBJECTIVE_COMPLETE",
      "USER_EXPLICIT_STOP_PAUSE_REVIEW_ONLY_OR_WAIT",
      "SAFETY",
      "AUTHORIZATION",
      "MISSING_USER_DATA",
      "UNAVOIDABLE_EXTERNAL_EVENT",
      "PLATFORM_OR_TOOL_LIMIT"
    ]
  },
  "terminal_scope_contract": {
    "allowed_scopes": [
      "NONE",
      "SUBFLOW",
      "TASK",
      "PARENT_OBJECTIVE"
    ],
    "SUBFLOW": "REEVALUATE_PARENT_OBJECTIVE",
    "TASK": "REEVALUATE_PARENT_OBJECTIVE",
    "PARENT_OBJECTIVE": "EMIT_PARENT_TERMINAL_FINAL only when parent objective is actually complete",
    "rule": "LOCAL_TERMINAL_SCOPE_MUST_NOT_BE_PROMOTED_TO_PARENT_TERMINAL_SCOPE"
  },
  "continuation_lease": {
    "activation_semantics": [
      "continue",
      "keep going",
      "do not stop",
      "until no further progress",
      "until satisfied",
      "solve blocker and continue",
      "multi-step parent completion criterion"
    ],
    "state": "ACTIVE_UNTIL_PARENT_CRITERION_MET_OR_USER_REVOKES",
    "cannot_be_consumed_by": [
      "STAGE_TERMINAL_VERDICT",
      "ROUTE_CLOSURE",
      "SEMANTIC_CHECKPOINT",
      "JOURNAL_WRITE",
      "PR_OR_BRANCH_SUBFLOW",
      "PUBLICATION_SUBFLOW"
    ]
  },
  "nonterminal_boundaries": [
    "TOOL_SUCCESS",
    "RECOVERABLE_TOOL_ERROR_WITH_ALTERNATIVE",
    "SEMANTIC_CHECKPOINT",
    "JOURNAL_WRITE",
    "BRANCH_OR_PR_METADATA_BOUNDARY",
    "MERGEABLE_OR_CI_OR_REVIEW_PENDING_NONBLOCKING",
    "STAGE_PASS_FAIL_OR_CLOSE",
    "DRIVER_VERDICT",
    "PROGRESS_UPDATE",
    "PUBLICATION_COMPLETE",
    "LOCAL_SOFT_BLOCK_WITH_INDEPENDENT_WORK_AVAILABLE"
  ],
  "stage_rule": {
    "pass_is_not_successor_trigger": true,
    "stage_terminal_requires_same_turn_successor_gate_evaluation": true,
    "local_close_may_happen_without_successor": true,
    "if_parent_goal_open_after_local_close": "SELECT_NEXT_HIGHEST_LEVERAGE_EXECUTABLE_PORTFOLIO_ACTION_IN_SAME_TURN"
  },
  "remote_rule": {
    "remote_subflow_terminated_is_parent_task_terminated": false,
    "ci_pending_nonblocking": "CONTINUE_PARENT_TASK",
    "checkpoint_persisted": "RESUME_PARENT_TASK",
    "tool_result_received": "RESUME_PARENT_TASK",
    "supported_alternative_after_tool_failure": "TAKE_ALTERNATIVE_WITHOUT_USER_WAKEUP_UNLESS_AUTHORIZATION_OR_SAFETY_REQUIRES_INPUT"
  },
  "terminal_conditions": [
    "PARENT_USER_OBJECTIVE_COMPLETE",
    "USER_EXPLICITLY_REQUESTS_STOP_PAUSE_REVIEW_ONLY_OR_WAIT",
    "GENUINE_SAFETY_AUTHORIZATION_MISSING_USER_DATA_OR_UNAVOIDABLE_EXTERNAL_EVENT_BLOCK",
    "PLATFORM_OR_TOOL_LIMIT_MAKES_FURTHER_ACTION_IMPOSSIBLE_THIS_TURN"
  ],
  "before_terminal_block": "EXHAUST_INDEPENDENT_AND_DOWNSTREAM_SAFE_WORK_AND_RETURN_STRONGEST_CURRENT_RESULT",
  "forbidden_state": "WAITING_FOR_CONTINUE_WHEN_CONTINUE_ADDS_NO_INFORMATION"
}
